# ==============================================================================
# WeatherCast AI — Senior Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL - NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
local_settings.py
secrets.json
credentials.json
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# 2. Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 3. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ------------------------------------------------------------------------------
# 4. Databases & Django State
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
db.sqlite3
db.sqlite3-journal
staticfiles/

# ------------------------------------------------------------------------------
# 5. Logs & Temporary Output
# ------------------------------------------------------------------------------
*.log
logs/
*.log.*
*.pid
tmp/
temp/
scratch/

# ------------------------------------------------------------------------------
# 6. Testing, Code Quality & Coverage
# ------------------------------------------------------------------------------
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ------------------------------------------------------------------------------
# 7. IDE & Operating System Artifacts
# ------------------------------------------------------------------------------
# JetBrains / PyCharm
.idea/
*.iws
*.iml
*.ipr

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Sublime Text
*.sublime-workspace
*.sublime-project

# OS Artifacts (macOS & Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 8. Local Backup & Scratch Dirs
# ------------------------------------------------------------------------------
_backup/
backup/
*.bak
*.swp
*~
