# ==============================================================================
# WeatherCast AI — Environment Configuration Template
# Copy this file to '.env' in local environments (never commit .env to version control)
# ==============================================================================

# Security
DJANGO_SECRET_KEY=change-this-to-a-secure-random-64-character-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Server & Network
PORT=8000

# Open-Meteo Integration (Default public API endpoints, custom proxies if applicable)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO
